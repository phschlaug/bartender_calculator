<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:views="clr-namespace:BartenderCalculator.Views"
            x:Class="BartenderCalculator.Views.DesktopMainView">

    <FlyoutPage.Flyout>
        <ContentPage Title="Menu">
            <StackLayout>
                <Button Text="Configure Products" Clicked="ShowConfiguration" />
                <Button Text="Create Order" Clicked="ShowOrder" />
            </StackLayout>
        </ContentPage>
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <ContentPage>
            <Label Text="Please select sn option from the menu"/>
        </ContentPage>
    </FlyoutPage.Detail>
</FlyoutPage>