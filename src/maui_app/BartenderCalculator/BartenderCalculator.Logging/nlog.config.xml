<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!-- Define targets -->
    <targets>
        <!-- File target -->
        <target name="file" xsi:type="File" fileName="logs/bartender_calculator_logfile.log" layout="${longdate} ${level} ${message} ${exception:format=toString}" />

        <!-- Console target -->
        <target name="console" xsi:type="Console" layout="${longdate} ${level} ${message} ${exception:format=toString}" />
    </targets>

    <!-- Define rules -->
    <rules>
        <logger name="*" minlevel="Trace" writeTo="file,console" />
    </rules>
</nlog>